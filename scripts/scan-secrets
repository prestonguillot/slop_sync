#!/usr/bin/env fish
# scan-secrets — high-confidence regex scan for secrets in input.
#
# Usage:
#   scan-secrets [FILE...]     — scan named files
#   git diff --cached | scan-secrets  — scan piped input
#
# Emits one line per finding ("LABEL: MATCH"), exit code = count of findings.
# Designed for use as a pre-commit safety net, not a comprehensive scanner —
# use gitleaks/trufflehog for thorough auditing.

set -l content_tmp (mktemp)
if test (count $argv) -gt 0
    cat $argv 2>/dev/null > $content_tmp
else
    cat > $content_tmp
end

set -g _hits 0

function _check --inherit-variable content_tmp
    set -l label $argv[1]
    set -l pat $argv[2]
    set -l matches (grep -Eo -- "$pat" $content_tmp 2>/dev/null | sort -u | head -3)
    for m in $matches
        echo "$label: $m"
        set -g _hits (math $_hits + 1)
    end
end

# Provider tokens (high confidence — prefix + length make false positives rare).
_check "AWS access key"        'AKIA[0-9A-Z]{16}'
_check "GitHub token"          'gh[poursi]_[A-Za-z0-9_]{36,}'
_check "Slack token"           'xox[abprs]-[A-Za-z0-9-]{10,}'
_check "Stripe live key"       'sk_live_[A-Za-z0-9]{24,}'
_check "OpenAI-style key"      'sk-[A-Za-z0-9]{20,}'
_check "Anthropic key"         'sk-ant-[A-Za-z0-9_-]{20,}'
_check "Google API key"        'AIza[0-9A-Za-z_-]{35}'
_check "Twilio account SID"    'AC[a-f0-9]{32}'
_check "Square access token"   'sq0atp-[A-Za-z0-9_-]{22}'

# Format markers (catches any flavor of key file content).
_check "PEM private key"       '-----BEGIN [A-Z ]+ PRIVATE KEY-----'
_check "OpenSSH private key"   '-----BEGIN OPENSSH PRIVATE KEY-----'
_check "PGP private key block" '-----BEGIN PGP PRIVATE KEY BLOCK-----'

# Generic-but-distinctive (JWTs are very pattern-y).
_check "JWT-like token"        'eyJ[A-Za-z0-9_-]{8,}\.eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}'

rm -f $content_tmp
exit $_hits
