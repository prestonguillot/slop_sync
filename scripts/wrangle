#!/usr/bin/env fish
# wrangle — the sync command. See README.md for the full picture.
#
# Branch model: each machine has its own branch (the "machine-branch") that
# declares a parent via git config (`branch.<name>.wrangle-parent`). The
# parent chain has arbitrary depth — e.g. work → personal → main. At the
# start of every run wrangle walks the chain root-toward-leaf, merging each
# parent into its child (skipping edges that are already up-to-date). On
# merge conflict the cascade stops; resume after manual resolution with
# `wrangle --resume-pull`.
#
# Passes (in order):
#   1. Parent-chain pull    — fetch + cascade-merge along the chain to machine-branch
#   2. Yoink check          — broken symlinks in ~ → offer to remove from home/
#   3. Orphan-symlink check — dangling symlinks in ~ pointing into home/ → remove
#   4. Re-stow              — link any new files in home/ to ~
#   5. Dotfile drift        — untracked files in ~/.config + ~ → [t/i/s/q]
#   6. Fisher drift         — installed vs ~/.config/fish/fish_plugins → [t/i/s/q] or [i/r/s/q]
#   7. Univ-var drift       — installed fish universals (per-prefix) → [t/i/s/q]
#   8. Brew drift           — installed vs Brewfile → [t/i/s/q] or [i/r/s/q]
#   9. Changelog            — append summary of changes to .wrangle-changelog
#  10. Commit               — secret-scan staged diff, commit with auto/llm message
#  11. Doc sync (opt-in)    — claude reviews + edits .md files; commits separately
#  12. Push                 — preview unpushed commits + stat; [y/N/d=diff] prompt
#
# The first-run "do you want claude doc-review?" opt-in question is asked
# UP FRONT (after the welcome banner, before drift detection) so the answer
# applies to this run's doc-sync, not just future runs.
#
# Prompts use consistent letters:
#   [t]rack          — capture into the repo
#   [i]gnore forever — append to .dotignore or .brewignore (track) / install (brew/plugin)
#   [r]emove         — yoink/drop from the repo
#   [s]kip           — leave alone; ask again next run
#   [q]uit
#
# Flags:
#   -d, --dry-run             show drift without prompting (no changes, no commit)
#   -f, --force               re-ask about paths in .dotignore
#   --with-claude             force-on claude doc review this run (overrides opt-out file)
#   --suppress-claude         force-off claude this run (overrides opt-in file)
#   --reset-claude-session    nuke the cached claude session id; start fresh next run
#   -p, --pull                walk parent chain (fetch + cascade-merge), then exit
#   --resume-pull             continue a cascade interrupted by a merge conflict
#   --set-parent <branch>     write branch.<current>.wrangle-parent in git config
#   -h, --help
#
# Env vars:
#   Opt-outs (all features default-on when applicable):
#     WRANGLE_NO_COMMIT=1          skip auto-commit
#     WRANGLE_NO_PUSH=1            skip push prompt
#     WRANGLE_NO_PUSH_NAG=1        silence the unpushed-commits nag in new shells
#     WRANGLE_NO_PULL_NAG=1        silence the upstream-changes-pending nag in new shells
#     WRANGLE_NO_STALENESS_NAG=1   silence the "wrangle hasn't run in N days" nag
#     WRANGLE_NO_BRANCH_SWITCH=1   skip the auto-switch to machine-branch
#     WRANGLE_ALLOW_SECRETS=1      bypass scan-secrets at commit time
#   Claude tuning (defaults are fast/cheap; raise for heavier reasoning):
#     WRANGLE_CLAUDE_MODEL=sonnet  override claude model (alias or full name)
#     WRANGLE_CLAUDE_EFFORT=low    override effort: low|medium|high|xhigh|max
# Git config (per-clone):
#   wrangle.machine-branch <name>           which branch this machine owns (default: personal)
#   branch.<name>.wrangle-parent <parent>   what to merge from at the start of each run
#                                           (default: main; empty = root branch with no parent)

# ── Subcommand dispatch ────────────────────────────────────────────────
# Shape: `wrangle <subcmd> [<args>...]`. Bare `wrangle`, `wrangle -h`, and
# `wrangle --help` all print the top-level help (matching git's convention).
# Subcommands must be given explicitly — there's no default-to-sync shorthand.
set -g _subcmd
if test (count $argv) -eq 0
    set _subcmd help
else if test "$argv[1]" = -h; or test "$argv[1]" = --help
    set _subcmd help
    set -e argv[1]
else if string match -q -- '-*' $argv[1]
    echo "wrangle: '$argv[1]' is a flag, not a subcommand." >&2
    echo "Run `wrangle help` for a list of subcommands." >&2
    exit 2
else
    set _subcmd $argv[1]
    set -e argv[1]
end

# Reject unknown subcommands.
switch $_subcmd
    case sync pull push review-docs import-univ-vars set-parent reset-claude-session help
        # known — handled below
    case '*'
        echo "wrangle: unknown subcommand: $_subcmd" >&2
        echo "Run `wrangle help` for a list of subcommands." >&2
        exit 2
end

# Argparse: declares the UNION of all subcommand flags. We then validate
# per-subcommand which flags are allowed (and reject combinations like
# `wrangle pull --dry-run` where the flag belongs to a different subcommand).
# Argparse must run at top-level (not in a switch/if) so the resulting
# _flag_* vars survive into the rest of the script.
argparse h/help d/dry-run f/force with-claude suppress-claude no-branch-switch resume -- $argv
or exit 1

# Per-subcommand flag-validity gate.
function _wrangle_reject_flag --argument-names subcmd flag
    echo "wrangle $subcmd: unknown option: $flag" >&2
    echo "Run `wrangle help $subcmd` for valid options." >&2
    exit 2
end
switch $_subcmd
    case sync
        set -q _flag_resume; and _wrangle_reject_flag sync --resume
    case pull
        set -q _flag_dry_run;          and _wrangle_reject_flag pull --dry-run
        set -q _flag_force;            and _wrangle_reject_flag pull --force
        set -q _flag_with_claude;      and _wrangle_reject_flag pull --with-claude
        set -q _flag_suppress_claude;  and _wrangle_reject_flag pull --suppress-claude
        set -q _flag_no_branch_switch; and _wrangle_reject_flag pull --no-branch-switch
    case push review-docs import-univ-vars set-parent reset-claude-session help
        # No flags besides --help.
        set -q _flag_dry_run;          and _wrangle_reject_flag $_subcmd --dry-run
        set -q _flag_force;            and _wrangle_reject_flag $_subcmd --force
        set -q _flag_with_claude;      and _wrangle_reject_flag $_subcmd --with-claude
        set -q _flag_suppress_claude;  and _wrangle_reject_flag $_subcmd --suppress-claude
        set -q _flag_no_branch_switch; and _wrangle_reject_flag $_subcmd --no-branch-switch
        set -q _flag_resume;           and _wrangle_reject_flag $_subcmd --resume
end

# ── Help printers ─────────────────────────────────────────────────────
function _wrangle_help_top
    echo "Usage: wrangle <subcommand> [args]"
    echo ""
    echo "Subcommands:"
    echo "  sync                  detect drift + commit + push (the main workflow)"
    echo "  pull [--resume]       fetch + cascade-merge along the parent chain"
    echo "  push                  push the current branch to origin (preview first)"
    echo "  review-docs           skip drift; have claude review docs against recent commits"
    echo "  import-univ-vars      restore captured fish universals from exported-univ-vars.fish"
    echo "  set-parent <branch>   declare current branch's wrangle-parent in git config"
    echo "  reset-claude-session  drop cached claude session id; next claude call uses a fresh one"
    echo "  help [<subcmd>]       this message, or detailed help for a subcommand"
    echo ""
    echo "Env-var knobs:"
    echo "  WRANGLE_NO_COMMIT             skip the commit pass"
    echo "  WRANGLE_NO_PUSH               skip the push pass"
    echo "  WRANGLE_NO_PUSH_NAG           silence unpushed-commits nag on shell start"
    echo "  WRANGLE_NO_PULL_NAG           silence upstream-changes-pending nag on shell start"
    echo "  WRANGLE_NO_STALENESS_NAG      silence \"hasn't run in N days\" nag on shell start"
    echo "  WRANGLE_NO_BRANCH_SWITCH      skip the parent-chain pull at sync start"
    echo "  WRANGLE_ALLOW_SECRETS         bypass scan-secrets at commit time"
    echo "  WRANGLE_CLAUDE_MODEL=sonnet   override claude model"
    echo "  WRANGLE_CLAUDE_EFFORT=low     override claude effort (low|medium|high|xhigh|max)"
    echo ""
    echo "Git config (per-clone):"
    echo "  wrangle.machine-branch <name>           which branch this machine owns (default: personal)"
    echo "  branch.<X>.wrangle-parent <parent>      what to merge from at the start of each run"
    echo "                                          (default: main; main itself never has a parent)"
end

function _wrangle_help_sync
    echo "Usage: wrangle sync [-d|--dry-run] [-f|--force]"
    echo "                    [--with-claude|--suppress-claude]"
    echo "                    [--no-branch-switch]"
    echo ""
    echo "Find dotfile + plugin + univ-var + brew drift and (by default) prompt"
    echo "per-item what to do. Commits the result. Optionally pushes."
    echo ""
    echo "Options:"
    echo "  -d, --dry-run         detect drift, change nothing, no commit, no push"
    echo "  -f, --force           re-ask about paths already in .dotignore"
    echo "  --with-claude         force-on claude doc review this run (overrides config)"
    echo "  --suppress-claude     force-off claude this run (overrides config)"
    echo "  --no-branch-switch    skip the parent-chain pull at the start (stay on current branch)"
end

function _wrangle_help_pull
    echo "Usage: wrangle pull [--resume]"
    echo ""
    echo "Fetch from origin and cascade-merge along the parent chain. For each"
    echo "(parent, child) edge in the chain, real-merges parent into child (unless"
    echo "the child already has the parent's commits, in which case skip)."
    echo ""
    echo "On merge conflict, stops mid-cascade, prints resolve instructions, and"
    echo "saves resume state. Resolve manually (`git add` + `git commit`) then"
    echo "continue with `wrangle pull --resume`."
    echo ""
    echo "Options:"
    echo "  --resume    continue a cascade that was interrupted by a merge conflict"
end

function _wrangle_help_push
    echo "Usage: wrangle push"
    echo ""
    echo "Push the current branch to origin. Shows a brief preview of the unpushed"
    echo "commits and their diffstat first, then pushes (no y/N prompt — typing"
    echo "the subcommand IS the decision). Use this when the shell-start unpushed"
    echo "nag fires, or after declining `[N]o` to the push prompt in `wrangle sync`."
    echo ""
    echo "If the branch has no upstream yet, git's first push will prompt with the"
    echo "usual `git push --set-upstream origin <branch>` suggestion."
end

function _wrangle_help_review_docs
    echo "Usage: wrangle review-docs"
    echo ""
    echo "Skip drift detection entirely; invoke claude to review the repo's docs"
    echo "against the current state and recent commits. Useful after a flurry of"
    echo "changes when wrangle's per-run doc-sync didn't catch up."
    echo ""
    echo "Requires the claude CLI on PATH. Ignores the wrangle.claude opt-in setting"
    echo "(if you ran this subcommand, you opted in for this run)."
end

function _wrangle_help_import_univ_vars
    echo "Usage: wrangle import-univ-vars"
    echo ""
    echo "Source `home/.config/fish/exported-univ-vars.fish` to restore captured"
    echo "plugin universal variables (tide, sponge, etc.) on a fresh machine."
    echo "Errors if the file doesn't exist — capture them first by answering"
    echo "[t]rack on a univ-var prefix during a `wrangle sync` session."
end

function _wrangle_help_set_parent
    echo "Usage: wrangle set-parent <branch>"
    echo ""
    echo "Declare <branch> as the wrangle-parent of the current branch. Writes"
    echo "branch.<current>.wrangle-parent to git config (per-clone). Used by"
    echo "`wrangle pull` to determine where the cascade merges from."
    echo ""
    echo "Refuses to run if the current branch is `main` (main is always the root)."
end

function _wrangle_help_reset_claude_session
    echo "Usage: wrangle reset-claude-session"
    echo ""
    echo "Drop the cached claude session id at ~/.cache/dotfiles/claude-session-id."
    echo "The next claude invocation (from any other subcommand) starts a fresh"
    echo "session instead of resuming the previous one. Useful when you want claude"
    echo "to re-read repo state from scratch rather than relying on prior context."
end

# Dispatch help if requested.
if test "$_subcmd" = help
    if test (count $argv) -eq 0
        _wrangle_help_top
    else
        switch $argv[1]
            case sync;                  _wrangle_help_sync
            case pull;                  _wrangle_help_pull
            case push;                  _wrangle_help_push
            case review-docs;           _wrangle_help_review_docs
            case import-univ-vars;      _wrangle_help_import_univ_vars
            case set-parent;            _wrangle_help_set_parent
            case reset-claude-session;  _wrangle_help_reset_claude_session
            case '*'
                echo "wrangle: unknown subcommand: $argv[1]" >&2
                exit 2
        end
    end
    exit 0
end

if set -q _flag_help
    switch $_subcmd
        case sync;                  _wrangle_help_sync
        case pull;                  _wrangle_help_pull
        case push;                  _wrangle_help_push
        case review-docs;           _wrangle_help_review_docs
        case import-univ-vars;      _wrangle_help_import_univ_vars
        case set-parent;            _wrangle_help_set_parent
        case reset-claude-session;  _wrangle_help_reset_claude_session
    end
    exit 0
end

if test "$_subcmd" = sync
    if set -q _flag_with_claude; and set -q _flag_suppress_claude
        echo "$GLYPH_ERR --with-claude and --suppress-claude are mutually exclusive." >&2
        exit 2
    end
end

set -g _dry_run no
set -g _force no
set -q _flag_dry_run; and set -g _dry_run yes
set -q _flag_force; and set -g _force yes

set -l script_dir (dirname (realpath (status -f)))
set -l repo (git -C $script_dir rev-parse --show-toplevel 2>/dev/null)
if test -z "$repo"
    echo "$GLYPH_ERR wrangle must live inside a git repo (couldn't resolve from $script_dir)."
    exit 1
end
set -l home_subdir $repo/home
set -l ignore_file $repo/.dotignore
set -l brew_ignore_file $repo/.brewignore
set -l changelog_file $repo/.wrangle-changelog
set -l cache_dir ~/.cache/dotfiles
set -l last_run_stamp $cache_dir/last-wrangle
set -l config_file $cache_dir/wrangle-config
set -l claude_session_file $cache_dir/claude-session-id
set -l pull_cascade_state $cache_dir/pull-cascade-state
set -l pull_nag_state $cache_dir/pull-nag-state

mkdir -p $cache_dir

# Detect first run (no last-wrangle timestamp yet on this machine).
set -g _first_run no
if not test -f $last_run_stamp
    set -g _first_run yes
end

# ─── Color + spinner helpers ──────────────────────────────────────────────
# Three-color visual hierarchy:
#   - Section headers (Pass titles, _header): bright magenta bold + heavy
#     ━━━ rules. Loudest — owns the page, scans as "new orientation point."
#   - Subheaders (per-item, _subheader): indented 2sp, cyan + light ───
#     rules. Visually nested under the parent section.
#   - File paths / branch names (_name): cyan, no bold. Mid-weight body
#     accent — same idiom git uses for paths.
#   - Input keys (_key, applied via _keys to bracketed letters): bright
#     yellow bold. Pops as "your turn to act."
# Other colors stay role-based: green=success, red=error, yellow=warning,
# brblack=dim. Box-drawing characters over emoji per house style. Colors
# degrade to noops on non-color terminals (fish's set_color handles that).
function _h     ; set_color --bold; end           # generic bold (used by _n)
function _ok    ; set_color brgreen --bold; end   # ✔ success
function _err   ; set_color brred --bold; end     # ✘ error
function _warn  ; set_color bryellow --bold; end  # ⚠ warning
function _dim   ; set_color brblack; end          # · neutral / hint
function _info  ; set_color cyan; end             # paths, branch names
function _lead  ; set_color brcyan --bold; end    # ▸ in-body leader callout
function _hdr   ; set_color brmagenta --bold; end # section header title
function _sub   ; set_color cyan; end             # subheader title
function _key   ; set_color bryellow --bold; end  # [t] [i] etc. in prompts
function _rs    ; set_color normal; end           # reset

# Glyph globals: include color + character + reset so we can drop them into
# existing format strings without restructuring everything. Heavy unicode
# variants (✔ ✘) over light (✓ ✗) for more presence at normal terminal
# weight — they need to draw the eye without emoji.
set -g GLYPH_OK    (_ok)"✔"(_rs)
set -g GLYPH_ERR   (_err)"✘"(_rs)
set -g GLYPH_WARN  (_warn)"⚠"(_rs)
set -g GLYPH_DIM   (_dim)"·"(_rs)                # separator / dim status
set -g GLYPH_LEAD  (_lead)"▸"(_rs)               # in-body leader (calls eye)
set -g GLYPH_ARROW (_dim)"→"(_rs)
set -g HEAD_RULE   (_dim)"━━━"(_rs)
set -g SUB_RULE    (_dim)"───"(_rs)

# Print a section header: dim ━━━ rules flanking a bright-magenta-bold title.
# Standardizes every pass's header so headers look identical across the script.
function _header
    echo "$HEAD_RULE "(_hdr)"$argv"(_rs)" $HEAD_RULE"
end

# Print a subheader nested under a section: 2sp indent, dim ─── rules,
# cyan title. Used by _show (per-file blocks during drift) so each item
# clearly sits inside its parent section.
function _subheader
    echo "  $SUB_RULE "(_sub)"$argv"(_rs)" $SUB_RULE"
end

# Colorize bracketed key letters in a prompt template. Replaces every `[x]`
# (where x is one or more chars) with a bright-yellow-bold version, leaving
# surrounding text default-colored. Use as: read -P (_keys "  [t]rack / …")
function _keys --argument-names text
    set -l o (_key)
    set -l z (_rs)
    # Single-quote the [$1] middle so fish doesn't try to index $o or expand $1.
    set -l repl $o'[$1]'$z
    string replace -ra '\[([^]]+)\]' $repl -- $text
end

# Format a count for inline display: bold for non-zero (signal), dim for
# zero (visual fade so the eye skips it). Used in summary lines and
# "Found N untracked" callouts.
function _n
    if test "$argv[1]" = "0"
        printf '%s0%s' (_dim) (_rs)
    else
        printf '%s%s%s' (_h) "$argv[1]" (_rs)
    end
end

# Format an item name (file path, plugin name, var name) for emphasis in
# drift listings — cyan to set it apart from surrounding prose.
function _name
    printf '%s%s%s' (_info) "$argv[1]" (_rs)
end

# Spinner: shows braille animation on a single line until _spinner_stop fires.
# Skipped if stderr isn't a TTY (no point repainting, and CI captures choke
# on the \r overwrites). NB: `status is-interactive` returns false inside a
# script even when invoked from an interactive shell — use `test -t 2` to
# detect a writable terminal directly. The original `is-interactive` check
# made every spinner since v1.5.0 silently no-op.
function _spinner_start --argument-names label
    test -t 2; or return
    set -gx _SPINNER_LABEL $label
    # --no-config: this subshell only needs printf + sleep. Sourcing config.fish
    # would re-run fnm/plugin init in a backgrounded subprocess where fnm's
    # shell-detection fails ("Can't infer shell!") and leaks to stderr.
    fish --no-config -c '
        set chars ⣾ ⣽ ⣻ ⢿ ⡿ ⣟ ⣯ ⣷
        set i 1
        while true
            printf "\r  \033[36m%s\033[0m %s " "$chars[$i]" "$_SPINNER_LABEL" >&2
            set i (math "($i % 8) + 1")
            sleep 0.1
        end
    ' &
    set -g _spinner_pid $last_pid
end

function _spinner_stop
    if set -q _spinner_pid
        kill $_spinner_pid 2>/dev/null
        wait $_spinner_pid 2>/dev/null
        printf "\r\033[K" >&2     # CR + erase-to-end-of-line
        set -e _spinner_pid
        set -e _SPINNER_LABEL
    end
end

# Run a command with a spinner showing $label, swallow stdout into a temp
# file, on success: re-emit the captured output; on failure: print it under
# a warning. Returns the wrapped command's exit status. Stderr passes through
# live so things like sudo password prompts still work.
#
# Usage:  _with_spinner "doing thing…" the_command arg1 arg2
function _with_spinner --argument-names label
    set -l cmd $argv[2..-1]
    _spinner_start "$label"
    set -l out (mktemp)
    $cmd > $out
    set -l rv $status
    _spinner_stop
    if test -s $out
        cat $out
    end
    rm -f $out
    return $rv
end

# `wrangle reset-claude-session` — drop the cached session id, exit.
if test "$_subcmd" = reset-claude-session
    rm -f $claude_session_file
    printf "%s✓%s Cleared cached claude session id. Next claude invocation starts fresh.\n" (_ok) (_rs)
    exit 0
end

# Accumulators for the run summary.
set -g _changes
function _log_change --inherit-variable _changes
    set -g _changes $_changes $argv[1]
end

# Report tracked-file modifications that didn't surface through this pass's
# drift checks — e.g. a `fisher install` outside wrangle updates fish_plugins
# alongside the install, so installed-vs-file matches (no drift) but the FILE
# is dirty in git. Each drift pass calls this with its domain files so the
# user sees the external edit AND `_changes` gets an entry (so doc-sync runs).
#
# Usage: _report_external_changes "description" path1 [path2 ...]
function _report_external_changes --inherit-variable repo
    set -l description $argv[1]
    set -l files $argv[2..-1]
    set -l dirty
    for f in $files
        if test -n "$(git -C $repo status --porcelain -- $f 2>/dev/null | string trim)"
            set -a dirty $f
        end
    end
    test (count $dirty) -eq 0; and return
    echo "  $GLYPH_LEAD $description"
    git -C $repo diff --stat --color=always -- $dirty 2>/dev/null | sed 's/^/    /'
    _log_change "$description"
end

# Run-abort helper. [q] in any prompt and Ctrl-C both route through here so
# the entire run exits cleanly — previously [q] only broke the current pass
# and fell through to the next one, and Ctrl-C was swallowed by `read` and
# matched the empty-string skip case. Tracked files already moved into home/
# and .univexport/.univignore edits stay on disk; re-run wrangle to commit.
function _wrangle_abort --argument-names reason exit_code
    test -z "$exit_code"; and set exit_code 0
    _spinner_stop   # clear any half-rendered spinner before our message
    echo ""
    echo "  $GLYPH_DIM $reason — exiting without committing or pushing. Re-run wrangle to commit any tracked changes."
    exit $exit_code
end
function _wrangle_on_sigint --on-signal SIGINT
    _wrangle_abort interrupted 130
end

# Claude invocation helper. Single source of truth for model/effort/session-id
# defaults and the claude CLI flags. Streams text output so the user sees
# progress in real time. Session ID is owned by us (generated via uuidgen,
# cached at $claude_session_file) — claude does the right thing whether the
# id is new or already-known.
function _wrangle_invoke_claude --inherit-variable claude_session_file
    set -l model sonnet
    set -l effort low
    test -n "$WRANGLE_CLAUDE_MODEL"; and set model "$WRANGLE_CLAUDE_MODEL"
    test -n "$WRANGLE_CLAUDE_EFFORT"; and set effort "$WRANGLE_CLAUDE_EFFORT"

    if not test -f $claude_session_file
        uuidgen | string lower > $claude_session_file
    end
    set -l session_id (cat $claude_session_file)

    echo "  $GLYPH_DIM model=$model · effort=$effort · session="(string sub --start=1 --length=8 -- $session_id)"…"
    echo ""

    # Spinner runs for the full claude duration. The streamed output appears
    # below the spinner line as it arrives; not pretty but cheap and
    # unambiguous ("something is happening"). Stopping the spinner on first-
    # byte requires piping through fish in a way that loses exit status.
    # --permission-mode acceptEdits: auto-approve Edit/Write on the .md files
    # claude is asked to maintain.
    # --allowedTools: explicit whitelist so claude doesn't waste a turn (and
    # noisy output) trying Bash/WebFetch/etc. only to hit the no-TTY wall.
    # Doc review needs to read files, grep for references, and edit/create
    # markdown — nothing else.
    _spinner_start "claude thinking… (model=$model effort=$effort)"
    claude -p --output-format text --permission-mode acceptEdits \
        --allowedTools "Read,Edit,Write,Grep,Glob" \
        --model $model --effort $effort --session-id $session_id "$argv[1]"
    set -l rv $status
    _spinner_stop
    return $rv
end

# ── Parent-chain helpers ──────────────────────────────────────────────────
# Branch metadata lives in git config (per-clone, not pushed):
#   branch.<name>.wrangle-parent <parent-branch-name>     # empty = root
#   wrangle.machine-branch <branch-name>                   # this machine's branch

function _wrangle_machine_branch --inherit-variable repo
    set -l mb (git -C $repo config wrangle.machine-branch 2>/dev/null)
    test -z "$mb"; and set mb personal
    echo $mb
end

function _wrangle_parent_of --inherit-variable repo --argument-names branch
    test -z "$branch"; and return 1
    # `main` is hardcoded as root: it never has a parent, regardless of config.
    test "$branch" = main; and return 1
    set -l p (git -C $repo config "branch.$branch.wrangle-parent" 2>/dev/null)
    if test -z "$p"
        # Default unset → assume `main` is the parent of everything that
        # isn't main itself. Backward-compat for setups that pre-date the
        # parent-chain feature (just `main` + `personal`).
        echo main
    else
        echo $p
    end
end

# Walk the parent chain root-toward-leaf. Returns the chain as a list:
# e.g. for `work` → [main, personal, work].
function _wrangle_chain_for --inherit-variable repo --argument-names branch
    set -l chain
    set -l cur $branch
    while test -n "$cur"
        set chain $cur $chain
        set cur (_wrangle_parent_of $cur)
    end
    for b in $chain
        echo $b
    end
end

# Cache-file helpers for the pull-cascade resume state.
# Format: one line per remaining edge as "parent:child", e.g.
#   main:personal
#   personal:work
# Plus a first line "ORIGINAL_BRANCH:<name>" so we know where to land back.
function _wrangle_save_cascade_state --inherit-variable pull_cascade_state
    set -l original $argv[1]
    set -l remaining_edges $argv[2..-1]
    echo "ORIGINAL_BRANCH:$original" > $pull_cascade_state
    for edge in $remaining_edges
        echo $edge >> $pull_cascade_state
    end
end

function _wrangle_clear_cascade_state --inherit-variable pull_cascade_state
    rm -f $pull_cascade_state
end

# Update the pull-nag cache so a successful merge stops re-nagging until new
# upstream activity. Records the SHA of origin/<parent> we just merged from.
function _wrangle_record_pull_nag --inherit-variable pull_nag_state --inherit-variable repo
    set -l parent $argv[1]
    set -l sha (git -C $repo rev-parse origin/$parent 2>/dev/null)
    test -z "$sha"; and return
    set -l tmp (mktemp)
    if test -f $pull_nag_state
        grep -v "^$parent:" $pull_nag_state > $tmp 2>/dev/null
    end
    echo "$parent:$sha" >> $tmp
    mv $tmp $pull_nag_state
end

# Run the cascade. Walks (parent, child) edges root-toward-leaf, skipping
# edges where the child already has the parent's commits. On a merge conflict
# saves resume state and exits non-zero. Returns the original branch (where
# we landed back on success).
#
# Usage: _wrangle_pull_chain  → walks from machine-branch's chain
#        _wrangle_pull_chain --resume → continues from saved state
function _wrangle_pull_chain --inherit-variable repo --inherit-variable pull_cascade_state
    set -l resume no
    if test "$argv[1]" = --resume
        set resume yes
    end

    pushd $repo >/dev/null

    set -l original
    set -l edges

    if test $resume = yes
        if not test -f $pull_cascade_state
            echo "  $GLYPH_DIM no cascade in progress, nothing to resume"
            popd >/dev/null
            return 0
        end
        # Verify no merge is mid-flight (user has committed the resolution).
        if test -f $repo/.git/MERGE_HEAD
            echo "  $GLYPH_ERR merge still in progress — resolve and `git commit` first, then re-run --resume-pull"
            popd >/dev/null
            return 1
        end
        set -l first_line (head -1 $pull_cascade_state)
        set original (string replace 'ORIGINAL_BRANCH:' '' -- $first_line)
        set edges (tail -n +2 $pull_cascade_state)
    else
        set original (git rev-parse --abbrev-ref HEAD)
        set -l machine_branch (_wrangle_machine_branch)
        set -l chain (_wrangle_chain_for $machine_branch)
        # Build (parent, child) edges from the chain. For chain [main, personal, work]:
        # edges = [main:personal, personal:work]
        if test (count $chain) -lt 2
            # Only one branch in the chain (e.g. machine-branch is `main` itself).
            popd >/dev/null
            return 0
        end
        for i in (seq 1 (math (count $chain) - 1))
            set edges $edges (printf '%s:%s' $chain[$i] $chain[(math $i + 1)])
        end

        _with_spinner "Fetching origin…" git fetch origin --prune 2>/dev/null
    end

    set -l merged_any no
    for edge in $edges
        set -l parts (string split ':' -- $edge)
        set -l parent $parts[1]
        set -l child $parts[2]

        # Skip-if-no-work check. Use origin/$parent so we count what's
        # fetched, not what's in the local parent branch (which might be
        # stale if we haven't checked it out in a while).
        set -l parent_ref origin/$parent
        # If origin/$parent doesn't exist (e.g. the parent is local-only),
        # fall back to the local branch.
        if not git rev-parse --verify --quiet $parent_ref >/dev/null
            set parent_ref $parent
        end

        set -l ahead (git rev-list --count "$child..$parent_ref" 2>/dev/null)
        test -z "$ahead"; and set ahead 0

        if test "$ahead" -eq 0
            echo "  $GLYPH_DIM $child already has "(_name $parent)"'s changes (skip)"
            continue
        end

        # Checkout the child branch (creating from parent if it doesn't exist).
        if not git show-ref --verify --quiet refs/heads/$child
            _with_spinner "Creating $child from $parent_ref…" git checkout -b $child $parent_ref 2>&1
        else
            _with_spinner "Switching to $child…" git checkout $child 2>&1
        end

        # Real merge (--no-ff to preserve the merge boundary in git log).
        _spinner_start "Merging "(_name $parent_ref)" into "(_name $child)" ($ahead commit(s))…"
        set -l merge_out (git merge --no-ff $parent_ref -m "merge $parent_ref into $child (wrangle --pull)" 2>&1)
        set -l merge_rv $status
        _spinner_stop

        if test $merge_rv -ne 0
            # Probably a conflict. Save resume state with remaining edges
            # (starting from this one, since it's now mid-merge).
            set -l remaining_idx (contains -i -- $edge $edges)
            set -l remaining $edges[$remaining_idx..-1]
            _wrangle_save_cascade_state $original $remaining
            echo ""
            echo "  $GLYPH_WARN merge conflict during cascade: "(_name $parent_ref)" → "(_name $child)
            echo "    Files needing resolution:"
            git diff --name-only --diff-filter=U | sed 's|^|      |'
            echo ""
            echo "  Resolve, then:"
            echo "    git add <files> && git commit"
            echo "    wrangle pull --resume"
            popd >/dev/null
            return 1
        end

        echo "  $GLYPH_OK merged "(_n $ahead)" commit(s) from "(_name $parent_ref)" into "(_name $child)
        _wrangle_record_pull_nag $parent
        set merged_any yes
    end

    # Back to where we started.
    if test (git rev-parse --abbrev-ref HEAD) != $original
        _with_spinner "Switching back to $original…" git checkout $original 2>&1
    end

    _wrangle_clear_cascade_state
    popd >/dev/null
    return 0
end

# Run the push step. Mode: 'prompt' (sync style — show preview + y/N/d loop)
# or 'immediate' (push subcommand style — preview, then push without asking).
# Returns the git push exit status (or 0 if nothing to push).
function _wrangle_do_push --inherit-variable repo --argument-names mode
    pushd $repo >/dev/null
    set -l remote (git remote | head -1)
    if test -z "$remote"
        echo "  $GLYPH_DIM no remote configured; nothing to push"
        popd >/dev/null
        return 0
    end

    set -l branch (git rev-parse --abbrev-ref HEAD)
    set -l upstream_exists no
    git rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; and set upstream_exists yes

    set -l unpushed 0
    if test $upstream_exists = yes
        set unpushed (git rev-list --count '@{u}..HEAD' 2>/dev/null)
    else
        set unpushed (git rev-list --count HEAD 2>/dev/null)
    end

    if test $unpushed -eq 0
        echo "  $GLYPH_OK already up to date with $remote/$branch"
        popd >/dev/null
        return 0
    end

    # Preview block (same for both modes).
    if test $upstream_exists = yes
        echo "  "(_n $unpushed)" commit(s) ahead of "(_name "$remote/$branch")":"
        git --no-pager log --color=always --pretty='    %C(yellow)%h%Creset %s' '@{u}..HEAD'
        echo ""
        echo "  Changed files:"
        git --no-pager diff --stat --color=always '@{u}..HEAD' | sed 's/^/    /'
    else
        echo "  Branch "(_name $branch)" has no upstream yet — first push will set it on "(_name $remote)"."
        echo "  Last commit:"
        git --no-pager log -1 --color=always --pretty='    %C(yellow)%h%Creset %s'
    end

    if test "$mode" = immediate
        # Push without prompting — user typed the subcommand, that IS the decision.
        echo ""
        _spinner_start "Pushing to $remote…"
        git push 2>&1
        set -l push_rv $status
        _spinner_stop
        if test $push_rv -eq 0
            echo "  $GLYPH_OK pushed"
        else
            echo "  $GLYPH_WARN push failed"
        end
        popd >/dev/null
        return $push_rv
    end

    # Prompt mode (sync's Pass 12). Loop on [d]iff, return on y/n.
    while true
        echo ""
        read -P (_keys "  Push to $remote? [y]es / [N]o / [d]iff (full) > ") push_choice
        switch $push_choice
            case d D diff
                if test $upstream_exists = yes
                    git --no-pager diff --color=always '@{u}..HEAD' | less -R
                else
                    git log -p --color=always | less -R
                end
                # loop back to re-prompt
            case y Y yes
                _spinner_start "Pushing to $remote…"
                git push 2>&1
                set -l push_rv $status
                _spinner_stop
                if test $push_rv -eq 0
                    echo "  $GLYPH_OK pushed"
                else
                    echo "  $GLYPH_WARN push failed"
                end
                popd >/dev/null
                return $push_rv
            case n N no ''
                echo "  $GLYPH_DIM skipped"
                popd >/dev/null
                return 0
            case '*'
                echo "  ? '$push_choice' — y / n / d"
        end
    end
end

# `wrangle set-parent <branch>` — write branch.<current>.wrangle-parent, exit.
if test "$_subcmd" = set-parent
    if test (count $argv) -ne 1
        echo "$GLYPH_ERR set-parent expects exactly one argument (the parent branch name)" >&2
        echo "  usage: wrangle set-parent <branch>" >&2
        exit 2
    end
    set -l target $argv[1]
    set -l current (git -C $repo rev-parse --abbrev-ref HEAD)
    if test "$current" = main
        echo "$GLYPH_ERR refusing to set a wrangle-parent on main (main is the root)" >&2
        exit 1
    end
    git -C $repo config "branch.$current.wrangle-parent" "$target"
    echo "  $GLYPH_OK branch.$current.wrangle-parent = "(_name $target)
    exit 0
end

# `wrangle pull [--resume]` — cascade, exit.
if test "$_subcmd" = pull
    _header "Parent-chain pull"
    if set -q _flag_resume
        _wrangle_pull_chain --resume
    else
        _wrangle_pull_chain
    end
    exit $status
end

# `wrangle push` — push current branch to origin (preview, no prompt), exit.
if test "$_subcmd" = push
    _header "Push"
    _wrangle_do_push immediate
    exit $status
end

# `wrangle import-univ-vars` — source the exported file, exit.
if test "$_subcmd" = import-univ-vars
    set -l export_file $repo/home/.config/fish/exported-univ-vars.fish
    if not test -f $export_file
        echo "$GLYPH_ERR No exported-univ-vars.fish found at $export_file." >&2
        echo "  Capture them first by running `wrangle sync` and answering [t]rack on a univ-var prefix." >&2
        exit 1
    end
    _header "Importing universal variables"
    set -l before_count (count (set -U -L))
    source $export_file
    set -l after_count (count (set -U -L))
    set -l delta (math $after_count - $before_count)
    echo "  $GLYPH_OK sourced $export_file ($delta new vars set; $after_count total universals now)"
    exit 0
end

# `wrangle review-docs` — skip drift entirely, invoke claude on current state.
# Useful when you opted into claude AFTER making changes (so the normal sync
# doc-sync path skipped because $_changes was empty), or when you've hand-
# edited docs and want a sanity check. Runs only the claude pass with recent
# commit log as context.
if test "$_subcmd" = review-docs
    if not command -q claude
        echo "$GLYPH_ERR review-docs requires the claude CLI." >&2
        exit 1
    end
    _header "Doc review"
    echo "  Asking claude to review docs against recent repo state..."

    set -l prompt_text "You are claude-code invoked by `wrangle review-docs` at $repo. The user has explicitly asked you to review the repo's documentation against the current state of the repo and recent activity. There are no specific changes from a wrangle run this time — your job is to look at the recent commits and current docs and propose updates if anything is factually wrong, out of date, or incomplete.

The repo has two doc tiers:
  - FRAMEWORK docs describe the sync system itself: README.md and setup-new-machine.md at the repo root. They live on `main` and should stay opinion-free.
  - PERSONAL docs describe the user's specific layer: post-bootstrap manual steps, tool-specific auth, machine-specific setup notes. Live on the machine-branch (default: `personal`). A common convention is a top-level PERSONAL.md.

You MAY edit any .md file and create new .md files. You MUST NOT touch anything under scripts/, the Brewfile, fish_plugins, .dotignore, .brewignore, .gitignore, any file under home/, or any dotfile/dotdir (including .claude/, .git/, .github/).

Only the Edit, Write, Read, Grep, and Glob tools are available to you. Don't attempt Bash, WebFetch, Task, etc. — there's no TTY to approve them and they'll fail.

Be conservative — only act on user-facing consequences.

Recent commit history (last 15 commits):
"
    for l in (git -C $repo log --oneline -15 2>/dev/null)
        set prompt_text "$prompt_text  $l
"
    end

    _wrangle_invoke_claude "$prompt_text"
    set -l rv $status
    echo ""
    if test $rv -eq 0
        echo "  $GLYPH_OK claude finished. `git status` in the repo to see any doc changes."
    else
        echo "  $GLYPH_WARN claude exited non-zero ($rv)."
    end
    exit $rv
end

# `$_claude_opt` (on/off) is computed later — right after the first-run
# opt-in question runs (so the just-saved answer is honored this run). Pass 10
# (commit message) and Pass 11 (doc-sync) both read it.

# Build a commit message. Three paths:
#   1. Single structural change → use it directly. claude can't improve much.
#   2. claude opt-in is on (and CLI present) → ask claude to summarize the diff.
#   3. Fall back to heuristic. For hand-edits (empty $_changes) describes the
#      file count; for multi-change uses "$first (+N more)".
function _build_commit_msg --inherit-variable _changes --inherit-variable repo
    set -l n (count $_changes)

    if test $n -eq 1
        echo "wrangle: $_changes[1]"
        return
    end

    if test "$_claude_opt" = on; and command -q claude
        set -l msg (_build_commit_msg_via_claude)
        if test $status -eq 0; and test -n "$msg"
            echo $msg
            return
        end
    end

    # Heuristic fallback
    if test $n -eq 0
        set -l file_count (git -C $repo diff --cached --name-only 2>/dev/null | count)
        if test $file_count -eq 1
            set -l f (git -C $repo diff --cached --name-only | head -1)
            echo "wrangle: edit $f"
        else
            echo "wrangle: sync $file_count file(s)"
        end
        return
    end

    echo "wrangle: $_changes[1] (+"(math $n - 1)" more)"
end

# Helper for the claude path of _build_commit_msg. Stateless — fresh session
# every invocation (commit messages don't need conversation continuity, and we
# don't want to pollute the doc-review session).
function _build_commit_msg_via_claude --inherit-variable _changes --inherit-variable repo
    set -l diff (git -C $repo diff --cached 2>/dev/null | head -300)
    test -z "$diff"; and return 1

    set -l changes_str ""
    for c in $_changes
        set changes_str "$changes_str- $c"\n
    end

    set -l prompt "Write a git commit message for this staged diff in a dotfiles repo.

Wrangle's own log of decisions this run (may be empty if these are hand-edits):
$changes_str
Staged diff (first 300 lines):
```
$diff
```

Rules:
- One-line subject, lowercase, no trailing period, prefer < 70 chars
- Describe the change cohesively; if multiple unrelated things, summarize
- Prefix with 'wrangle: ' if the change was wrangle-initiated; omit for user hand-edits
- Output ONLY the commit message subject line, no preamble, no explanation, no code fences, no quotes"

    set -l model sonnet
    set -l effort low
    test -n "$WRANGLE_CLAUDE_MODEL"; and set model "$WRANGLE_CLAUDE_MODEL"
    test -n "$WRANGLE_CLAUDE_EFFORT"; and set effort "$WRANGLE_CLAUDE_EFFORT"

    _spinner_start "Asking claude for a commit message…"
    set -l msg (claude -p --output-format text --model $model --effort $effort "$prompt" 2>/dev/null | string trim)
    _spinner_stop

    # Strip stray surrounding quotes/backticks claude sometimes adds.
    set msg (string replace -ra '^["`]+|["`]+$' '' -- $msg)
    test -z "$msg"; and return 1
    echo $msg
end

# ─── Pass 1: parent-chain pull ───────────────────────────────────────────
# Auto-switch to the machine-branch (default: personal), then cascade-merge
# along the parent chain. See _wrangle_pull_chain for the full semantics.
# Skip with --no-branch-switch / WRANGLE_NO_BRANCH_SWITCH=1.
if not set -q _flag_no_branch_switch; and test -z "$WRANGLE_NO_BRANCH_SWITCH"
    pushd $repo >/dev/null

    set -l machine_branch (_wrangle_machine_branch)
    set -l current_branch (git rev-parse --abbrev-ref HEAD)
    if test "$current_branch" != "$machine_branch"
        if git show-ref --verify --quiet refs/heads/$machine_branch
            _with_spinner "Switching to $machine_branch…" git checkout $machine_branch 2>&1
            echo "  $GLYPH_ARROW switched to "(_name $machine_branch)" (was on "(_name $current_branch)")"
        else
            set -l parent (_wrangle_parent_of $machine_branch)
            set -l from main
            test -n "$parent"; and set from $parent
            _with_spinner "Creating $machine_branch from $from…" git checkout -b $machine_branch $from 2>&1
            echo "  $GLYPH_ARROW created + switched to "(_name $machine_branch)" from "(_name $from)" (was on "(_name $current_branch)")"
        end
    end

    popd >/dev/null

    if test "$_dry_run" = no
        if git -C $repo remote | grep -q .
            _wrangle_pull_chain
            set -l cascade_rv $status
            if test $cascade_rv -ne 0
                # Cascade failed (conflict). Exit so user can resolve.
                exit $cascade_rv
            end
        end
    end
end


# ── First-run welcome ─────────────────────────────────────────────────────
if test "$_first_run" = yes; and test "$_dry_run" = no
    echo ""
    _header "First wrangle on this machine"
    echo "  I'll walk through what's already in ~ and ask what to track."
    echo "  Everything is non-destructive — nothing gets moved or modified"
    echo "  unless you say [t]rack."
    echo ""
end

# ── Claude opt-in question ───────────────────────────────────────────────
# Fires the first time wrangle is run *after the opt-in feature exists* —
# i.e., whenever $config_file is missing. Decoupled from $_first_run (which
# only catches truly-fresh machines) so existing users get asked the first
# time they run a wrangle version that knows about the question. Asked HERE
# (rather than at the end of the run) so the answer applies to THIS run's
# doc-sync, not just future runs.
if test "$_dry_run" = no; and not test -f $config_file
    echo ""
    _header "One-time question"
    echo "  wrangle can optionally use claude-code (the `claude` CLI) after each run"
    echo "  to review the repo's docs (framework and personal-layer) for changes that"
    echo "  need reflecting. It runs only when wrangle has actual changes, uses a"
    echo "  persistent session to avoid re-reading the repo each time, and obeys"
    echo "  --with-claude / --suppress-claude flags on individual runs."
    echo ""
    set -l answer no
    while true
        read -P (_keys "  Enable claude doc review by default on this machine? [y/N] > ") choice
        switch $choice
            case y Y yes
                set answer yes
                break
            case n N no ''
                set answer no
                break
            case '*'
                echo "  ? '$choice' — y or n"
        end
    end
    echo "WRANGLE_CLAUDE_OPT_IN=$answer" > $config_file
    echo "  $GLYPH_OK Saved to $config_file (edit that file to change later)."
end

# Determine effective claude opt-in for THIS run. Computed here (after the
# opt-in question) so a first-run "yes" answer takes effect immediately.
#   --suppress-claude       → off (overrides file)
#   --with-claude           → on (overrides file)
#   WRANGLE_CLAUDE_OPT_IN=yes in $config_file → on
#   else → off
set -g _claude_opt off
if test -f $config_file
    if grep -q 'WRANGLE_CLAUDE_OPT_IN=yes' $config_file
        set _claude_opt on
    end
end
set -q _flag_with_claude; and set _claude_opt on
set -q _flag_suppress_claude; and set _claude_opt off

# ─── Pass 2: yoink check ─────────────────────────────────────────────────
set -l yoink_candidates
if test "$_dry_run" = no; and test "$_first_run" = no
    set -l has_stow_links no
    for f in $HOME/.gitconfig $HOME/.vim/vimrc $HOME/.config/fish/config.fish
        if test -L $f; and string match -q "*$repo/*" -- (readlink $f)
            set has_stow_links yes
            break
        end
    end
    if test "$has_stow_links" = yes
        for f in (find $home_subdir -type f -not -name .gitkeep 2>/dev/null)
            set -l rel (string replace -- "$home_subdir/" "" $f)
            set -l target $HOME/$rel
            if not test -e $target; and not test -L $target
                set -a yoink_candidates $rel
            end
        end
    end
end

if test (count $yoink_candidates) -gt 0
    _header "Yoink check"
    echo "  Files in home/ but missing from ~ ("(_n (count $yoink_candidates))") — looks like you removed them:"
    for rel in $yoink_candidates
        echo ""
        echo "    "(_name "home/$rel")
        while true
            read -P (_keys "    [y]oink (remove from repo) / [r]estore (stow back) / [s]kip / [q]uit > ") choice
            switch $choice
                case y Y yoink
                    rm $home_subdir/$rel
                    set -l parent (dirname $home_subdir/$rel)
                    while test "$parent" != "$home_subdir"; and test -z "$(ls -A $parent 2>/dev/null)"
                        rmdir $parent
                        set parent (dirname $parent)
                    end
                    echo "      $GLYPH_OK removed home/$rel"
                    _log_change "yoinked dotfile: $rel"
                    break
                case r R restore
                    echo "      $GLYPH_DIM will restore via stow"
                    break
                case s S skip ''
                    echo "      $GLYPH_DIM skipped"
                    break
                case q Q quit
                    _wrangle_abort quit
                case '*'
                    echo "      ? '$choice' — answer y/r/s/q"
            end
        end
    end
end

# ─── Pass 3: orphan-symlink check ────────────────────────────────────────
# Inverse of the yoink check above: ~ has a symlink pointing into the repo,
# but the source file in home/ no longer exists (e.g., you deleted it from
# home/ directly without unstowing first). `stow -R` leaves these behind.
# Find and clean them up before Pass 4 (re-stow) so subsequent installs
# don't trip over "conflicting file" errors.
set -l orphan_symlinks
if test "$_dry_run" = no
    # Scan top-level ~/.<name> and ~/.config/* paths.
    for f in $HOME/.[A-Za-z0-9]* $HOME/.config/* $HOME/.config/fish/conf.d/* $HOME/.config/fish/functions/*
        # Only consider symlinks
        test -L $f; or continue
        # Only consider symlinks pointing into this repo's home/
        set -l tgt (realpath $f 2>/dev/null)
        string match -q "$home_subdir/*" -- $tgt; or continue
        # Broken? (target doesn't resolve to an existing file)
        test -e $f; and continue  # `test -e` follows symlinks; false if target missing
        set -a orphan_symlinks $f
    end
end

if test (count $orphan_symlinks) -gt 0
    echo ""
    _header "Orphan symlinks"
    echo "  Symlinks in ~ pointing into home/ whose targets no longer exist ("(_n (count $orphan_symlinks))"):"
    for path in $orphan_symlinks
        echo ""
        echo "    "(_name $path)" $GLYPH_ARROW "(_name (readlink $path))
        while true
            read -P (_keys "    [r]emove dangling symlink / [s]kip / [q]uit > ") choice
            switch $choice
                case r R remove
                    rm $path
                    echo "      $GLYPH_OK removed $path"
                    _log_change "removed orphan symlink: $path"
                    break
                case s S skip ''
                    echo "      $GLYPH_DIM skipped"
                    break
                case q Q quit
                    _wrangle_abort quit
                case '*'
                    echo "      ? '$choice' — answer r/s/q"
            end
        end
    end
end

# ─── Pass 4: re-stow ─────────────────────────────────────────────────────
if command -q stow
    if test "$_dry_run" = no
        pushd $repo >/dev/null
        _with_spinner "Re-stowing home/ into ~…" stow --no-folding -R -t ~ home
        or begin
            popd >/dev/null
            echo "$GLYPH_ERR stow re-stow failed. Resolve conflicts (real files at target paths) and re-run."
            exit 1
        end
        popd >/dev/null
    end
else
    echo "$GLYPH_WARN  stow not installed; skipping re-stow."
end

# ─── Skiplist (sole source: .dotignore) ──────────────────────────────────
# Logic lives in scripts/_skiplist.fish (shared with test/skiplist.fish).
# `--force` bypasses .dotignore entirely (the pre-commit secret-scan is the
# secondary safety net).
source $repo/scripts/_skiplist.fish

set -l user_ignores
if test "$_force" = no
    set user_ignores (_wrangle_load_dotignore $ignore_file)
end

function _is_skipped --inherit-variable user_ignores
    _wrangle_is_skipped $argv[1] $user_ignores
end

function _is_tracked --inherit-variable home_subdir
    test -e $home_subdir/$argv[1]
end

function _show
    set -l rel $argv[1]
    set -l full $HOME/$rel
    echo ""
    # Subheader (2sp indent, light rules) — visually nests this block under
    # its parent section header. Body content sits one more level in (4sp).
    _subheader "~/$rel"
    if test -d $full
        set -l n (find $full -type f 2>/dev/null | count)
        set -l sz (du -sh $full 2>/dev/null | awk '{print $1}')
        echo "    directory $GLYPH_DIM $n file(s) · $sz"
        echo "    tree (depth 2):"
        find $full -maxdepth 2 2>/dev/null | head -15 | sed "s|$HOME/|      ~/|"
    else if test -f $full
        set -l sz (du -h $full 2>/dev/null | awk '{print $1}')
        set -l mt (stat -f '%Sm' $full)
        echo "    file $GLYPH_DIM $sz · $mt"
        echo "    preview:"
        head -8 $full 2>/dev/null | sed 's/^/      /'
    else
        echo "    (special / unreadable)"
    end
    echo ""
end

function _track --inherit-variable home_subdir --inherit-variable repo
    set -l rel $argv[1]
    set -l src $HOME/$rel
    set -l dest $home_subdir/$rel
    mkdir -p (dirname $dest)
    mv $src $dest
    or begin
        echo "      $GLYPH_ERR mv failed; aborting track"
        return 1
    end
    pushd $repo >/dev/null
    _with_spinner "Re-stowing after track…" stow --no-folding -R -t ~ home
    set -l rv $status
    popd >/dev/null
    if test $rv -eq 0
        echo "      $GLYPH_OK moved to home/$rel + symlinked back to ~/$rel"
    else
        echo "      $GLYPH_WARN moved but stow failed; resolve before committing"
    end
end

function _add_ignore --inherit-variable ignore_file
    echo $argv[1] >> $ignore_file
    echo "      $GLYPH_OK added to .dotignore"
end

# ─── Pass 5: dotfile drift ───────────────────────────────────────────────
echo ""
_header "Dotfile drift"
set -l candidates
for f in $HOME/.[A-Za-z0-9]*
    test -L $f; and continue
    set -l rel (string replace -- $HOME/ "" $f)
    if not _is_skipped $rel; and not _is_tracked $rel
        set -a candidates $rel
    end
end
for f in $HOME/.config/*
    test -L $f; and continue
    set -l rel (string replace -- $HOME/ "" $f)
    if not _is_skipped $rel; and not _is_tracked $rel
        set -a candidates $rel
    end
end

if test (count $candidates) -eq 0
    echo "  $GLYPH_OK no untracked dotfiles in scope"
else
    set -l mode_hint
    test "$_dry_run" = yes; and set mode_hint " (dry run — no prompts)"
    test "$_force" = yes; and set mode_hint "$mode_hint (--force: ignore list bypassed)"
    echo "  Found "(_n (count $candidates))" untracked path(s)$mode_hint."
end

set -l tracked_count 0
set -l ignored_count 0

for rel in $candidates
    _show $rel
    if test "$_dry_run" = yes
        continue
    end
    # Prompt + responses sit at 4sp to nest visually under the _show subheader.
    while true
        read -P (_keys "    [t]rack / [i]gnore forever / [s]kip / [q]uit > ") choice
        switch $choice
            case t T track
                if _track $rel
                    set tracked_count (math $tracked_count + 1)
                    _log_change "tracked dotfile: $rel"
                end
                break
            case i I ignore
                _add_ignore $rel
                set ignored_count (math $ignored_count + 1)
                _log_change "ignored dotfile: $rel"
                break
            case s S skip ''
                echo "      $GLYPH_DIM skipped (will ask again next run)"
                break
            case q Q quit
                _wrangle_abort quit
            case '*'
                echo "      ? '$choice' — answer t/i/s/q"
        end
    end
end

# Summary: only print a counts line when work actually happened (or in dry-run);
# otherwise the "no untracked dotfiles" ok-line above already conveys "all good".
if test "$_dry_run" = yes; and test (count $candidates) -gt 0
    echo "  $GLYPH_DIM dry run — "(_n (count $candidates))" untracked path(s) listed, nothing changed"
else if test $tracked_count -gt 0; or test $ignored_count -gt 0
    echo "  $GLYPH_OK "(_n $tracked_count)" tracked, "(_n $ignored_count)" newly ignored"
end

# Catch hand-edits to already-tracked dotfiles under home/ (the symlink-target
# is the same file, so an edit to ~/.config/foo IS an edit to home/.config/foo).
# Files covered by later passes (fish_plugins, Brewfile, .univexport/.univignore)
# are excluded — those passes report their own external changes.
set -l home_dirty (git -C $repo diff --name-only -- home/ 2>/dev/null | string match -v 'home/.config/fish/fish_plugins')
if test (count $home_dirty) -gt 0
    echo ""
    echo "  $GLYPH_LEAD tracked file(s) under home/ with uncommitted changes:"
    for f in $home_dirty
        echo "    "(_name $f)
    end
    git -C $repo diff --stat --color=always -- $home_dirty 2>/dev/null | sed 's/^/    /'
    _log_change (count $home_dirty)" tracked dotfile(s) hand-edited under home/"
end

# ─── Pass 6: fisher drift ────────────────────────────────────────────────
echo ""
_header "Fisher drift"
set -l plugin_changed no
if not command -q fish; or not functions -q fisher
    echo "  fisher not installed; skipping."
else
    set -l fisher_listed (fisher list 2>/dev/null)
    set -l plugins_file_path $HOME/.config/fish/fish_plugins
    set -l plugins_in_file
    if test -f $plugins_file_path
        set plugins_in_file (cat $plugins_file_path | grep -v '^#' | grep -v '^$')
    end

    set -l plugin_added
    for p in $fisher_listed
        contains -- $p $plugins_in_file; or set -a plugin_added $p
    end
    set -l plugin_missing
    for p in $plugins_in_file
        contains -- $p $fisher_listed; or set -a plugin_missing $p
    end

    if test (count $plugin_added) -eq 0; and test (count $plugin_missing) -eq 0
        echo "  $GLYPH_OK fisher list matches fish_plugins."
    end

    set -l fish_tracked 0
    set -l fish_uninstalled 0
    set -l fish_installed 0
    set -l fish_removed 0

    if test (count $plugin_added) -gt 0
        echo "  Installed but NOT in fish_plugins ("(_n (count $plugin_added))"):"
        for plugin in $plugin_added
            echo ""
            echo "    "(_name $plugin)
            if test "$_dry_run" = yes
                continue
            end
            while true
                read -P (_keys "    [t]rack (add to fish_plugins) / [i]ignore (uninstall) / [s]kip / [q]uit > ") choice
                switch $choice
                    case t T track
                        echo $plugin >> $plugins_file_path
                        set plugin_changed yes
                        set fish_tracked (math $fish_tracked + 1)
                        _log_change "tracked fisher plugin: $plugin"
                        echo "      $GLYPH_OK added to fish_plugins"
                        break
                    case i I ignore uninstall
                        _with_spinner "fisher remove $plugin…" fish -c "fisher remove $plugin"
                        set fish_uninstalled (math $fish_uninstalled + 1)
                        _log_change "uninstalled fisher plugin: $plugin"
                        echo "      $GLYPH_OK uninstalled"
                        break
                    case s S skip ''
                        echo "      $GLYPH_DIM skipped"
                        break
                    case q Q quit
                        _wrangle_abort quit
                    case '*'
                        echo "      ? '$choice' — answer t/i/s/q"
                end
            end
        end
    end

    if test (count $plugin_missing) -gt 0
        echo ""
        echo "  In fish_plugins but NOT installed ("(_n (count $plugin_missing))"):"
        for plugin in $plugin_missing
            echo ""
            echo "    "(_name $plugin)
            if test "$_dry_run" = yes
                continue
            end
            while true
                read -P (_keys "    [i]nstall / [r]emove from fish_plugins / [s]kip / [q]uit > ") choice
                switch $choice
                    case i I install
                        _with_spinner "fisher install $plugin…" fish -c "fisher install $plugin"
                        set fish_installed (math $fish_installed + 1)
                        _log_change "installed fisher plugin: $plugin"
                        echo "      $GLYPH_OK installed"
                        break
                    case r R remove
                        set -l tmp_p (mktemp)
                        grep -v -F -x -- "$plugin" $plugins_file_path > $tmp_p
                        mv $tmp_p $plugins_file_path
                        set plugin_changed yes
                        set fish_removed (math $fish_removed + 1)
                        _log_change "removed fisher plugin from fish_plugins: $plugin"
                        echo "      $GLYPH_OK removed from fish_plugins"
                        break
                    case s S skip ''
                        break
                    case q Q quit
                        _wrangle_abort quit
                    case '*'
                        echo "      ? '$choice' — answer i/r/s/q"
                end
            end
        end
    end

    # Catch fish_plugins modifications that didn't surface through the drift
    # check above — e.g. a `fisher install foo` (in or out of wrangle) added
    # `foo` to the file before this pass ran, so installed-vs-file matches
    # but the file is still dirty relative to its last commit.
    _report_external_changes "fish_plugins has uncommitted changes" home/.config/fish/fish_plugins

    # Summary: only if any work happened. Otherwise the "fisher list matches
    # fish_plugins" ok-line above is the summary.
    if test (math $fish_tracked + $fish_uninstalled + $fish_installed + $fish_removed) -gt 0
        echo "  $GLYPH_OK "(_n $fish_tracked)" tracked, "(_n $fish_uninstalled)" uninstalled, "(_n $fish_installed)" installed, "(_n $fish_removed)" removed from fish_plugins"
    end
end

# ─── Pass 7: univ-var drift ──────────────────────────────────────────────
# Tracks plugin universal variables (tide config, sponge config, etc.) so
# they survive `git clone` + bootstrap on a new machine. Necessary evil:
# fish universals are controversial upstream (#7379) but plugins like tide
# make them their SOLE persistence mechanism. Scope is intentionally narrow
# — see .univexport for the allowlist and the doc comments there.
#
# Drift detection mirrors brew/fisher/dotfile patterns:
#   - group installed univs by prefix
#   - filter by .univexport (already tracked) + .univignore (already ignored)
#   - prompt [t]rack / [i]gnore forever / [s]kip / [q]uit per remaining group
#   - on track: append pattern to .univexport, regenerate exported-univ-vars.fish
echo ""
_header "Univ-var drift"

set -l univ_export_file $repo/.univexport
set -l univ_ignore_file $repo/.univignore
set -l univ_output_file $repo/home/.config/fish/exported-univ-vars.fish
set -l univ_changed no

# Helper: extract the prefix of a univ var name (or empty if no underscore).
function _univ_prefix --argument-names name
    if string match -qr '^__[a-zA-Z0-9]+_' -- $name
        string match -r '^__[a-zA-Z0-9]+_' -- $name
    else if string match -qr '^_[a-zA-Z0-9]+_' -- $name
        string match -r '^_[a-zA-Z0-9]+_' -- $name
    else if string match -qr '^[a-zA-Z0-9]+_' -- $name
        string match -r '^[a-zA-Z0-9]+_' -- $name
    end
end

# Helper: regenerate $univ_output_file from current state + .univexport patterns.
function _univ_regenerate --inherit-variable univ_export_file --inherit-variable univ_output_file
    set -l patterns
    if test -f $univ_export_file
        set patterns (grep -vE '^\s*(#|$)' $univ_export_file)
    end
    if test (count $patterns) -eq 0
        # Nothing tracked — make sure output file doesn't linger from a previous state.
        rm -f $univ_output_file
        return
    end
    mkdir -p (dirname $univ_output_file)
    set -l tmp (mktemp)
    echo "# Auto-generated by wrangle. Edit .univexport (allowlist) and re-run wrangle." > $tmp
    echo "# Restore on a new machine with: wrangle --import-univ-vars" >> $tmp
    echo "" >> $tmp
    for name in (set -U -L | awk '{print $1}' | sort)
        set -l matched no
        for p in $patterns
            if string match -q $p $name
                set matched yes
                break
            end
        end
        test "$matched" = yes; or continue
        # Read the var's values via dereference.
        set -l values $$name
        # Skip empty.
        test (count $values) -eq 0; and continue
        echo "set -U --erase $name" >> $tmp
        printf 'set -U %s' $name >> $tmp
        for v in $values
            printf ' %s' (string escape -- $v) >> $tmp
        end
        printf '\n' >> $tmp
    end
    mv $tmp $univ_output_file
end

# Detection runs unconditionally; mutating actions (prompts + writes +
# regenerate) are gated by `$_dry_run` below so `wrangle sync --dry-run`
# still surfaces the auto-skipped count + drift summary.

# Load allowlist / blocklist patterns (skip comments + blanks).
set -l allowed_patterns
set -l ignored_patterns
if test -f $univ_export_file
    set allowed_patterns (grep -vE '^\s*(#|$)' $univ_export_file)
end
if test -f $univ_ignore_file
    set ignored_patterns (grep -vE '^\s*(#|$)' $univ_ignore_file)
end

# Get all current universals, partition into groups by prefix.
# We need: list of (prefix → [var names]) for untracked + un-ignored vars.
set -l drift_prefixes
set -l drift_standalone
set -l auto_skipped_private 0

for name in (set -U -L | awk '{print $1}')
    # Skip if matches any allowlist pattern (already tracked)
    set -l skip no
    for p in $allowed_patterns
        string match -q $p $name; and set skip yes; and break
    end
    test "$skip" = yes; and continue
    # Skip if matches any ignore pattern (already ignored)
    for p in $ignored_patterns
        string match -q $p $name; and set skip yes; and break
    end
    test "$skip" = yes; and continue
    # Auto-skip fish's private/internal convention: names starting with `_`
    # (fish builtins use `__name`, plugins use `_pluginname_*` for caches).
    # Explicit allowlist matches above still win, so you can opt in by
    # adding an exact name (e.g. `_foo`) to .univexport manually.
    if string match -q '_*' $name
        set auto_skipped_private (math $auto_skipped_private + 1)
        continue
    end

    set -l prefix (_univ_prefix $name)
    if test -z "$prefix"
        set -a drift_standalone $name
    else
        contains -- $prefix $drift_prefixes; or set -a drift_prefixes $prefix
    end
end

if test $auto_skipped_private -gt 0
    echo "  $GLYPH_DIM auto-skipped "(_n $auto_skipped_private)" private var(s) (leading _ — fish/plugin internals; add exact name to .univexport to opt in)"
end

set -l univ_tracked 0
set -l univ_ignored 0
set -l drift_total (math (count $drift_prefixes) + (count $drift_standalone))
if test $drift_total -eq 0
    echo "  $GLYPH_OK no univ-var drift (allowlist + blocklist cover all)"
else if test "$_dry_run" = yes
    echo "  $GLYPH_DIM dry run — "(_n $drift_total)" untracked group(s)/var(s) detected, nothing changed"
else
    echo "  Found "(_n $drift_total)" untracked group(s)/var(s)"


        # Prompt per prefix-group
        for prefix in $drift_prefixes
            # Collect actual vars under this prefix (sample up to 4 for display)
            set -l members
            for name in (set -U -L | awk '{print $1}')
                set -l np (_univ_prefix $name)
                test "$np" = "$prefix"; or continue
                set -a members $name
            end
            set -l count (count $members)
            echo ""
            echo "    prefix "(_name "$prefix*")" — "(_n $count)" var(s):"
            for m in $members
                echo "      "(_name $m)
            end
            while true
                read -P (_keys "    [t]rack pattern / [i]gnore forever / [s]kip / [q]uit > ") choice
                switch $choice
                    case t T track
                        echo "$prefix*" >> $univ_export_file
                        echo "      $GLYPH_OK added `$prefix*` to .univexport"
                        _log_change "tracked univ-var pattern: $prefix*"
                        set univ_changed yes
                        set univ_tracked (math $univ_tracked + 1)
                        break
                    case i I ignore
                        echo "$prefix*" >> $univ_ignore_file
                        echo "      $GLYPH_OK added `$prefix*` to .univignore"
                        echo "      $GLYPH_DIM tip: to capture an individual var from this prefix later,"
                        echo "      $GLYPH_DIM      add its exact name on its own line in .univexport"
                        echo "      $GLYPH_DIM      ($repo/.univexport — exact names match like patterns)"
                        _log_change "ignored univ-var pattern: $prefix*"
                        set univ_ignored (math $univ_ignored + 1)
                        break
                    case s S skip ''
                        echo "      $GLYPH_DIM skipped (will ask again next run)"
                        break
                    case q Q quit
                        _wrangle_abort quit
                    case '*'
                        echo "      ? '$choice' — answer t/i/s/q"
                end
            end
        end

        # Prompt per standalone (no-underscore) var, asking by exact name
        for name in $drift_standalone
            echo ""
            echo "    standalone (no prefix): "(_name $name)" = "(string join " " $$name)
            while true
                read -P (_keys "    [t]rack exact name / [i]gnore forever / [s]kip / [q]uit > ") choice
                switch $choice
                    case t T track
                        echo $name >> $univ_export_file
                        echo "      $GLYPH_OK added `$name` to .univexport"
                        _log_change "tracked univ-var: $name"
                        set univ_changed yes
                        set univ_tracked (math $univ_tracked + 1)
                        break
                    case i I ignore
                        echo $name >> $univ_ignore_file
                        echo "      $GLYPH_OK added `$name` to .univignore"
                        _log_change "ignored univ-var: $name"
                        set univ_ignored (math $univ_ignored + 1)
                        break
                    case s S skip ''
                        echo "      $GLYPH_DIM skipped (will ask again next run)"
                        break
                    case q Q quit
                        _wrangle_abort quit
                    case '*'
                        echo "      ? '$choice' — answer t/i/s/q"
                end
            end
        end
end   # closes the if/else if/else for drift status

# Side-effects (file writes, regenerate, dirty-file report) only when NOT in
# dry-run. Detection above already ran in both modes.
if test "$_dry_run" = no
    # Regenerate exported file if anything was tracked OR if the file's current
    # contents are stale relative to the live var values.
    if test "$univ_changed" = yes; or test -f $univ_output_file
        _univ_regenerate
    end

    # Catch hand-edits to .univexport / .univignore (e.g. user manually added
    # an exact name to opt-in a normally-auto-skipped private var).
    _report_external_changes ".univexport / .univignore has uncommitted changes" .univexport .univignore

    # Summary: only when work happened (the "no univ-var drift" ok-line above
    # already serves as the no-work summary).
    if test (math $univ_tracked + $univ_ignored) -gt 0
        echo "  $GLYPH_OK "(_n $univ_tracked)" tracked, "(_n $univ_ignored)" newly ignored"
    end
end

# ─── Pass 8: brew drift ──────────────────────────────────────────────────
# Brewfile mutations here are INCREMENTAL: each [t]rack appends one entry,
# each [r]emove deletes one entry. No end-of-pass re-dump, so [s]kip truly
# means "defer; ask me again next run." dump-brewfile is still used to
# DETECT drift (read-only comparison), just not to write back changes.
echo ""
_header "Brew drift"
if not command -q brew
    echo "  brew not installed; skipping."
else
    set -l tmp_dump (mktemp)
    _spinner_start "Scanning installed brew state…"
    $repo/scripts/dump-brewfile $tmp_dump 2>/dev/null
    _spinner_stop

    set -l brewfile_path $repo/Brewfile
    set -l tracked_entries
    if test -f $brewfile_path
        set tracked_entries (grep -E '^(brew|cask|mas|npm) ' $brewfile_path)
    end
    set -l installed_entries (grep -E '^(brew|cask|mas|npm) ' $tmp_dump)
    # NOTE: tmp_dump stays alive through the loops — [t]rack reads the
    #       description-comment for the entry out of it. Cleaned up after.

    set -l added
    for e in $installed_entries
        contains -- $e $tracked_entries; or set -a added $e
    end
    set -l missing
    for e in $tracked_entries
        contains -- $e $installed_entries; or set -a missing $e
    end

    set -l brew_tracked 0
    set -l brew_ignored 0
    set -l brew_installed 0
    set -l brew_removed 0

    if test (count $added) -eq 0; and test (count $missing) -eq 0
        echo "  $GLYPH_OK Brewfile matches installed state (with .brewignore applied)."
    end

    # Ensure Brewfile exists so we can append to it (fresh machine, no Brewfile yet).
    if test "$_dry_run" = no; and not test -f $brewfile_path
        touch $brewfile_path
    end

    if test (count $added) -gt 0
        echo "  Installed locally but NOT in Brewfile ("(count $added)"):"
        for entry in $added
            echo ""
            echo "    $entry"
            if test "$_dry_run" = yes
                continue
            end
            while true
                read -P (_keys "    [t]rack / [i]gnore forever / [s]kip / [q]uit > ") choice
                switch $choice
                    case t T track
                        # Look up the description comment from tmp_dump (the
                        # line immediately preceding $entry, if it's a comment).
                        set -l ln_raw (grep -n -F -x -- "$entry" $tmp_dump 2>/dev/null | head -1)
                        set -l desc ""
                        if test -n "$ln_raw"
                            set -l ln (string split ':' -- $ln_raw)[1]
                            if test "$ln" -gt 1
                                set -l prev_line (sed -n (math $ln - 1)"p" $tmp_dump)
                                if string match -q '#*' -- "$prev_line"
                                    set desc $prev_line
                                end
                            end
                        end
                        if test -n "$desc"
                            echo $desc >> $brewfile_path
                        end
                        echo $entry >> $brewfile_path
                        set brew_tracked (math $brew_tracked + 1)
                        _log_change "tracked brew: $entry"
                        echo "      $GLYPH_OK appended to Brewfile"
                        break
                    case i I ignore
                        set -l pat (string match -r '"[^"]+"' -- $entry)[1]
                        if test -z "$pat"
                            set pat $entry
                        end
                        echo $pat >> $brew_ignore_file
                        echo "      $GLYPH_OK added $pat to .brewignore"
                        set brew_ignored (math $brew_ignored + 1)
                        _log_change "brew-ignored: $pat"
                        break
                    case s S skip ''
                        echo "      $GLYPH_DIM skipped (will ask again next run)"
                        break
                    case q Q quit
                        _wrangle_abort quit
                    case '*'
                        echo "      ? '$choice' — answer t/i/s/q"
                end
            end
        end
    end

    if test (count $missing) -gt 0
        echo ""
        echo "  In Brewfile but NOT installed ("(count $missing)"):"
        for entry in $missing
            echo ""
            echo "    $entry"
            if test "$_dry_run" = yes
                continue
            end
            while true
                read -P (_keys "    [i]nstall / [r]emove from Brewfile / [s]kip / [q]uit > ") choice
                switch $choice
                    case i I install
                        set -l type (string split ' ' -- $entry)[1]
                        set -l name (string match -r '"[^"]+"' -- $entry)[1]
                        set -l name_unquoted (string trim --chars='"' -- $name)
                        set -l rv 0
                        switch $type
                            case brew
                                _with_spinner "brew install $name_unquoted…" brew install $name_unquoted
                                set rv $status
                            case cask
                                _with_spinner "brew install --cask $name_unquoted…" brew install --cask $name_unquoted
                                set rv $status
                            case mas
                                set -l id (string match -r 'id:\s*(\d+)' -- $entry)[2]
                                _with_spinner "mas install $name_unquoted ($id)…" mas install $id
                                set rv $status
                            case npm
                                _with_spinner "npm install -g $name_unquoted…" npm install -g $name_unquoted
                                set rv $status
                        end
                        if test $rv -eq 0
                            echo "      $GLYPH_OK installed"
                            set brew_installed (math $brew_installed + 1)
                            _log_change "installed: $entry"
                        else
                            echo "      $GLYPH_WARN install failed (exit $rv)"
                        end
                        break
                    case r R remove
                        # Locate the entry's line in Brewfile, delete it +
                        # preceding description comment if present.
                        set -l ln_raw (grep -n -F -x -- "$entry" $brewfile_path 2>/dev/null | head -1)
                        if test -z "$ln_raw"
                            echo "      $GLYPH_WARN couldn't find that line in Brewfile; nothing removed"
                            break
                        end
                        set -l ln (string split ':' -- $ln_raw)[1]
                        set -l to_delete $ln
                        if test "$ln" -gt 1
                            set -l prev_line (sed -n (math $ln - 1)"p" $brewfile_path)
                            if string match -q '#*' -- "$prev_line"
                                set to_delete (math $ln - 1)","$ln
                            end
                        end
                        set -l tmp_bf (mktemp)
                        sed "$to_delete""d" $brewfile_path > $tmp_bf
                        mv $tmp_bf $brewfile_path
                        set brew_removed (math $brew_removed + 1)
                        _log_change "removed from Brewfile: $entry"
                        echo "      $GLYPH_OK removed from Brewfile"
                        break
                    case s S skip ''
                        echo "      $GLYPH_DIM skipped (will ask again next run)"
                        break
                    case q Q quit
                        _wrangle_abort quit
                    case '*'
                        echo "      ? '$choice' — answer i/r/s/q"
                end
            end
        end
    end

    rm -f $tmp_dump

    # Catch Brewfile/.brewignore modifications that didn't surface through
    # drift — file was edited (hand or by dump-brewfile) but is now in sync
    # with the installed state.
    _report_external_changes "Brewfile / .brewignore has uncommitted changes" Brewfile .brewignore

    # Summary: parallel to the other passes — only counts line when work
    # happened; the "Brewfile matches installed state" ok-line above is the
    # no-work summary.
    if test "$_dry_run" = yes; and test (math (count $added) + (count $missing)) -gt 0
        echo "  $GLYPH_DIM dry run — "(_n (count $added))" untracked, "(_n (count $missing))" missing, nothing changed"
    else if test (math $brew_tracked + $brew_ignored + $brew_installed + $brew_removed) -gt 0
        echo "  $GLYPH_OK "(_n $brew_tracked)" tracked, "(_n $brew_ignored)" ignored, "(_n $brew_installed)" installed, "(_n $brew_removed)" removed"
    end
end

# ─── Touch timestamp ──────────────────────────────────────────────────────
if test "$_dry_run" = no
    touch $last_run_stamp
end

# ─── Pass 9: changelog ───────────────────────────────────────────────────
if test "$_dry_run" = no; and test (count $_changes) -gt 0
    for c in $_changes
        echo (date -Iseconds)" $c" >> $changelog_file
    end
end

# ─── Pass 10: commit (push happens later, after optional doc-sync) ───────
set -g _committed no
if test "$_dry_run" = no; and test -z "$WRANGLE_NO_COMMIT"
    pushd $repo >/dev/null
    if test (git status --porcelain | count) -gt 0
        echo ""
        _header "Commit"
        git add -A

        if test -z "$WRANGLE_ALLOW_SECRETS"
            _spinner_start "Scanning staged diff for secrets…"
            set -l secret_hits (git diff --cached | $repo/scripts/scan-secrets)
            _spinner_stop
            if test (count $secret_hits) -gt 0
                echo ""
                echo "$GLYPH_ERR SECRET-LIKE PATTERNS in staged diff — refusing to commit:"
                for h in $secret_hits
                    echo "    $h"
                end
                echo ""
                echo "Either remove the offending content, or bypass with WRANGLE_ALLOW_SECRETS=1 and re-run."
                echo "To unstage: cd $repo && git reset"
                popd >/dev/null
                exit 1
            end
        end

        set -l commit_msg (_build_commit_msg)
        _with_spinner "Committing…" git commit -m "$commit_msg"
        set -g _committed yes
        echo "  $GLYPH_OK committed: $commit_msg"
    end
    popd >/dev/null
end

# ─── Pass 11: claude-code doc review (opt-in) ────────────────────────────
# Runs AFTER the main commit but BEFORE the push, so any doc edits claude
# makes get committed (as a separate "docs:" commit so provenance is clear)
# and pushed in the same batch instead of leaving a dangling doc commit for
# next run. claude is invoked with --permission-mode acceptEdits so it can
# actually edit the .md files (was previously sandbox-blocked).
if test "$_dry_run" = no; and test "$_committed" = yes; and test "$_claude_opt" = on
    if not command -q claude
        echo "  $GLYPH_DIM claude not installed; skipping doc review."
    else
        echo ""
        _header "Doc sync"

        # Build context: changes from this run + any pending from prior runs.
        set -l prompt_text "You are claude-code invoked by `wrangle` at $repo. Your job: keep the repo's documentation aligned with reality as changes accumulate.

The repo has two documentation tiers:
  - FRAMEWORK docs describe the sync system itself: README.md and setup-new-machine.md at the repo root. They live on `main` and should stay opinion-free (no presumption of specific tools, no personal preferences). Edit these only if the framework itself changed in a way that makes existing text factually wrong.
  - PERSONAL docs describe the user's specific layer on top: post-bootstrap manual steps, tool-specific auth flows, machine-specific setup notes. These live on the machine-branch (default: `personal`). Create or update them when the machine-branch (Brewfile, tracked dotfiles, fish_plugins) adds something with known post-install or first-time-setup needs that aren't documented elsewhere. A common convention is a top-level PERSONAL.md, but you can split into multiple docs if it makes sense.

You MAY edit any .md file in the repo, and create new .md files when warranted. You MUST NOT touch anything under scripts/, the Brewfile, fish_plugins, .dotignore, .brewignore, .gitignore, any file under home/, or any dotfile/dotdir (including .claude/, .git/, .github/). Those are managed by other parts of the system.

Only the Edit, Write, Read, Grep, and Glob tools are available to you. Don't attempt Bash, WebFetch, Task, etc. — there's no TTY to approve them and they'll fail. Don't waste turns on tools that aren't whitelisted.

Be conservative: only act on changes that have real user-facing setup or behavior consequences. Skip cosmetic or trivial diffs.

Changes from this wrangle run:
"
        for c in $_changes
            set prompt_text "$prompt_text- $c
"
        end
        set prompt_text "$prompt_text
Recent commit history (for context — last 10 commits):
"
        set -l recent_log (git -C $repo log --oneline -10 2>/dev/null)
        for l in $recent_log
            set prompt_text "$prompt_text  $l
"
        end

        _wrangle_invoke_claude "$prompt_text"
        set -l rv $status
        echo ""
        if test $rv -ne 0
            echo "  $GLYPH_WARN claude exited non-zero ($rv); skipping doc commit."
        else
            pushd $repo >/dev/null
            if test (git status --porcelain | count) -eq 0
                echo "  $GLYPH_OK no doc changes warranted by this run."
            else
                # Sanity check: claude was told to only touch .md files. If it
                # modified anything else, warn loudly and leave it for the user
                # to inspect rather than committing it.
                set -l changed (git status --porcelain | awk '{print $2}')
                set -l non_md
                for f in $changed
                    string match -q '*.md' $f; or set -a non_md $f
                end
                if test (count $non_md) -gt 0
                    echo "  $GLYPH_WARN claude modified non-doc files; NOT committing:"
                    for f in $non_md
                        echo "    $f"
                    end
                    echo "  Inspect / clean up with: cd $repo && git status"
                else
                    git add -A
                    _with_spinner "Committing doc changes…" git commit -m "docs: sync with wrangle run "(date -u +%Y-%m-%dT%H:%MZ)
                    echo "  $GLYPH_OK doc changes committed."
                    _log_change "doc-sync committed by claude"
                end
            end
            popd >/dev/null
        end
    end
end

# ─── Pass 12: push (with preview + y/N/d prompt) ─────────────────────────
# Split out from the commit pass so doc-sync can interject its own commit
# between the two. Calls _wrangle_do_push in 'prompt' mode (show preview, ask
# before pushing); the `wrangle push` subcommand calls it in 'immediate' mode.
if test "$_dry_run" = no; and test -z "$WRANGLE_NO_PUSH"
    pushd $repo >/dev/null
    set -l _unpushed (git rev-list --count '@{u}..HEAD' 2>/dev/null)
    if test -n "$_unpushed"; and test $_unpushed -gt 0
        echo ""
        _header "Push"
        _wrangle_do_push prompt
    end
    popd >/dev/null
end

