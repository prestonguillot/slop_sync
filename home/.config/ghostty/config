theme = ayu

font-family = Monaspace Xenon
font-family-bold = Monaspace Xenon
font-family-italic = Monaspace Radon
font-family-bold-italic = Monaspace Radon

# Monaspace ligatures & features
font-feature = calt
font-feature = liga

font-size = 12

# Desktop notification when a command finishes in an unfocused ghostty window
# and runs longer than the threshold. Requires fish v4+ (which emits OSC 133
# natively) or shell-integration enabled.
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify
notify-on-command-finish-after = 5s
