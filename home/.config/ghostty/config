theme = ayu

font-family = Monaspace Xenon
font-family-bold = Monaspace Xenon
font-family-italic = Monaspace Xenon
font-family-bold-italic = Monaspace Xenon
font-style-italic = Italic
font-style-bold-italic = Bold Italic

# Fallback for glyphs Monaspace doesn't ship (Nerd Font PUA range — tide
# prompt icons, eza file-type icons, lazygit/k9s/etc.). Ghostty walks
# font-family entries in order for missing glyphs. Installed via
# `brew install --cask font-symbols-only-nerd-font`.
font-family = Symbols Nerd Font Mono

# Monaspace ligatures & features
font-feature = calt
font-feature = liga

font-size = 12

# Desktop notification when a command finishes in an unfocused ghostty window
# and runs longer than the threshold. Requires fish v4+ (which emits OSC 133
# natively) or shell-integration enabled.
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify
notify-on-command-finish-after = 5s